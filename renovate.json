{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "rebaseWhen": "conflicted",
  "swift": {
    "enabled": true,
    "updateLockFiles": false
  },
  "packageRules": [
    {
      "matchManagers": ["swift"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold APNSwift below 8.0: vapor/apns 5.1.0 declares apnswift 7.0.1..<8.0.0, so an 8.x bump makes dependency resolution fail. Raise once vapor/apns ships a release that accepts apnswift 8.",
      "matchManagers": ["swift"],
      "matchPackageNames": ["swift-server-community/APNSwift", "https://github.com/swift-server-community/APNSwift"],
      "allowedVersions": "<8.0.0"
    }
  ]
}
